{%- liquid
  assign target = product.selected_or_first_available_variant

  assign compare_at_price = target.compare_at_price
  assign price = target.price | default: 1999

  assign on_sale = false
  if compare_at_price != blank and compare_at_price > price
    assign on_sale = true
  endif

  assign in_stock = true
  if target.inventory_management == 'shopify'
    if target.inventory_quantity < 1 and target.inventory_policy != 'continue'
      assign in_stock = false
    endif
  endif
-%}

{%- if product.available == false or in_stock == false or on_sale or product.tags.size > 0 -%}
  <div class="btfy-product-card__badge">

    {%- if product.available == false or in_stock == false -%}
      {%- if settings.show_soldout_badge -%}
        <span class="f-badge f-badge--soldout" aria-hidden="true">
          {{- 'products.product.sold_out' | t -}}
        </span>
      {%- endif -%}
    {%- else -%}

      {%- if on_sale and settings.show_sale_badge -%}
        {%- liquid
          assign sale_badge = ''

          case settings.sale_badge_type
            when 'text'
              assign sale_badge = settings.sale_badge_custom_text

            when 'percentage'
              assign discount_amount = compare_at_price | minus: price
              assign discount_percentage = discount_amount | times: 100 | divided_by: compare_at_price
              assign discount_percentage = discount_percentage | round
              assign sale_badge = settings.sale_badge_custom_text | append: ' ' | append: discount_percentage | append: '%'

            when 'fixed_amount'
              assign discount_amount = compare_at_price | minus: price | money
              assign sale_badge = 'products.product.price.save_price_html' | t: amount: discount_amount

            else
              assign sale_badge = 'products.product.on_sale' | t
          endcase
        -%}

        <span class="f-badge f-badge--sale" aria-hidden="true">
          {{- sale_badge -}}
        </span>
      {%- endif -%}

    {%- endif -%}

    {%- for tag in product.tags -%}
      {%- if tag contains 'tag__' -%}
        {%- liquid
          assign tag_content = tag | split: '__' | last
          assign type = tag_content | split: '_' | first
          assign tag_name = tag_content | split: '_' | last
        -%}
        <span class="f-badge f-badge--{{ type }}">
          {{- tag_name | escape -}}
        </span>
      {%- else -%}
        <span class="f-badge f-badge--custom">
          {{- tag | escape -}}
        </span>
      {%- endif -%}
    {%- endfor -%}

  </div>
{%- endif -%}
