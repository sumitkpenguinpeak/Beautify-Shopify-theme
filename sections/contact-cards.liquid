                              <path d="M12.9525 5.70896C14.2796 5.93183 15.4852 6.55994 16.4476 7.52236C17.41 8.48478 18.0331 9.69034 18.261 11.0175C18.3167 11.3518 18.6055 11.5848 18.9347 11.5848C18.9752 11.5848 19.0107 11.5797 19.0512 11.5747C19.4261 11.5139 19.6743 11.1593 19.6135 10.7845C19.3399 9.17873 18.5801 7.71484 17.4202 6.55487C16.2602 5.39491 14.7963 4.6351 13.1906 4.36157C12.8158 4.30079 12.4662 4.54899 12.4004 4.91876C12.3345 5.28853 12.5777 5.64817 12.9525 5.70896Z" fill="currentColor"></path>
                              <path d="M23.9547 10.5869C23.5039 7.94279 22.2578 5.53674 20.3431 3.62203C18.4284 1.70732 16.0224 0.461243 13.3783 0.0104253C13.0085 -0.0554245 12.659 0.197844 12.5931 0.567615C12.5323 0.942452 12.7806 1.29196 13.1554 1.35781C15.5158 1.75798 17.6686 2.87742 19.3807 4.58445C21.0928 6.29654 22.2072 8.44932 22.6074 10.8098C22.6631 11.1441 22.9518 11.3771 23.2811 11.3771C23.3216 11.3771 23.357 11.372 23.3976 11.367C23.7673 11.3113 24.0206 10.9567 23.9547 10.5869Z" fill="currentColor"></path>
                            </svg>
                        {% when 'email' %}
                          <svg viewBox="0 0 24 17" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M21.8906 0H2.10938C0.943922 0 0 0.949781 0 2.10938V14.7656C0 15.9321 0.950859 16.875 2.10938 16.875H21.8906C23.0463 16.875 24 15.9361 24 14.7656V2.10938C24 0.951844 23.0598 0 21.8906 0ZM21.5952 1.40625C21.1642 1.83492 13.7476 9.21249 13.4916 9.4672C13.0931 9.86564 12.5634 10.085 12 10.085C11.4366 10.085 10.9069 9.86559 10.5071 9.46589C10.3349 9.29456 3.00014 1.99847 2.40478 1.40625H21.5952ZM1.40625 14.4794V2.39648L7.48303 8.44125L1.40625 14.4794ZM2.40567 15.4688L8.48006 9.43298L9.51408 10.4616C10.1781 11.1256 11.061 11.4913 12 11.4913C12.939 11.4913 13.8219 11.1256 14.4846 10.4629L15.5199 9.43298L21.5943 15.4688H2.40567ZM22.5938 14.4794L16.517 8.44125L22.5938 2.39648V14.4794Z" fill="currentColor"></path>
                          </svg>
                        {% when 'address' %}
                          <svg viewBox="0 0 15 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                              <path d="M7.50463 11.4963C9.674 11.4963 11.4389 9.73157 11.4389 7.56247C11.4389 5.39338 9.674 3.62872 7.50463 3.62872C5.33525 3.62872 3.57031 5.39338 3.57031 7.56247C3.57031 9.73157 5.33525 11.4963 7.50463 11.4963ZM7.50463 5.03479C8.89859 5.03479 10.0327 6.16874 10.0327 7.56247C10.0327 8.95625 8.89864 10.0902 7.50463 10.0902C6.11061 10.0902 4.97656 8.95625 4.97656 7.56247C4.97656 6.16874 6.11066 5.03479 7.50463 5.03479Z" fill="currentColor"/>
                              <path d="M3.22095 14.6311C4.28665 16.0738 3.85849 15.5128 6.9281 19.8953C7.2071 20.2952 7.8004 20.2971 8.08099 19.896C11.1645 15.4926 10.7402 16.0503 11.7886 14.6311C12.8505 13.1933 13.9487 11.7067 14.5505 9.9645C15.4215 7.44258 15.045 4.94728 13.4905 2.93822C13.4904 2.93822 13.4904 2.93817 13.4904 2.93817C12.0664 1.09837 9.82878 0 7.50476 0C5.18074 0 2.94312 1.09837 1.5191 2.93827C-0.0354114 4.94733 -0.411912 7.44267 0.45912 9.96459C1.06081 11.7067 2.15899 13.1934 3.22095 14.6311ZM2.63126 3.7987C3.79085 2.30053 5.61274 1.40606 7.50476 1.40606C9.39678 1.40606 11.2187 2.30053 12.3783 3.7987L12.3782 3.79866C13.6329 5.42016 13.9322 7.44694 13.2212 9.50559C12.6897 11.0444 11.6565 12.4431 10.6574 13.7958C9.87945 14.8489 10.1123 14.5268 7.50476 18.2645C4.89996 14.5305 5.12984 14.8486 4.35214 13.7958C3.35299 12.4431 2.31982 11.0444 1.78831 9.50559C1.07731 7.44689 1.37665 5.42016 2.63126 3.7987Z" fill="currentColor"/>
                              <path d="M3.79836 17.6797C3.59099 17.3515 3.15674 17.2534 2.82842 17.4608L0.829205 18.7235C0.39308 18.9989 0.392658 19.6365 0.829205 19.9122L7.12921 23.8914C7.35856 24.0363 7.65088 24.0362 7.88019 23.8914L14.1802 19.9122C14.6164 19.6368 14.6167 18.9992 14.1802 18.7235L12.181 17.4608C11.8526 17.2534 11.4184 17.3515 11.211 17.6797C11.0036 18.008 11.1017 18.4422 11.43 18.6496L12.4881 19.3179L7.50467 22.4654L2.52125 19.3179L3.57941 18.6496C3.90772 18.4422 4.00574 18.008 3.79836 17.6797Z" fill="currentColor"/>
                           </svg>
                      {% endcase %}
                    </div>
                    <span class="info-number">
                      {{ block.settings.number }}
                    </span>
                    <div class="info-content">
                      {% if block.settings.title != blank %}
                        <h3>{{ block.settings.title }}</h3>
                      {% endif %}
                      {% if block.settings.content != blank %}
                        {{ block.settings.content }}
                      {% endif %}
                    </div>
                  </div>
              {% endcase %}
            {% endfor %}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Contact Info Cards",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Container color scheme",
      "default": "scheme-2"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    }
  ],
  "blocks": [
    {
      "type": "image_card",
      "name": "Image card",
      "limit": 1,
      "settings": [
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Color scheme",
          "default": "scheme-1"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "image_picker",
          "id": "image_mobile",
          "label": "Mobile image"
        },
        {
          "type": "range",
          "id": "image_overlay_opacity",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "%",
          "label": "Image overlay opacity",
          "default": 0
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "Image card"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "default": "h1",
          "options": [
            { "value": "h6", "label": "H6" },
            { "value": "h5", "label": "H5" },
            { "value": "h4", "label": "H4" },
            { "value": "h3", "label": "H3" },
            { "value": "h2", "label": "H2" },
            { "value": "h1", "label": "H1" }
          ]
        },
        {
          "type": "text",
          "id": "subheading",
          "label": "Subheading"
        },
        {
          "type": "richtext",
          "id": "description",
          "label": "Description"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label"
        },
        {
          "type": "select",
          "id": "button_style",
          "label": "Button style",
          "default": "btn--underline",
          "options": [
            {
              "value": "btn--primary",
              "label": "Primary"
            },
            {
              "value": "btn--secondary",
              "label": "Secondary"
            },
            {
              "value": "btn--underline",
              "label": "Underline"
            }
          ]
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "default": "bottom-left",
          "options": [
            { "value": "top-left", "label": "Top left" },
            { "value": "top-center", "label": "Top center" },
            { "value": "top-right", "label": "Top right" },
            { "value": "middle-left", "label": "Middle left" },
            { "value": "middle-center", "label": "Middle center" },
            { "value": "middle-right", "label": "Middle right" },
            { "value": "bottom-left", "label": "Bottom left" },
            { "value": "bottom-center", "label": "Bottom center" },
            { "value": "bottom-right", "label": "Bottom right" }
          ]
        },
        {
          "type": "select",
          "id": "content_alignment",
          "label": "Content alignment",
          "default": "left",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "select",
          "id": "content_alignment_mobile",
          "label": "Mobile alignment",
          "default": "center",
          "options": [
            { "value": "left", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ]
        },
        {
          "type": "select",
          "id": "content_spacing",
          "label": "Content spacing",
          "default": "large",
          "options": [
            { "value": "small", "label": "Small" },
            { "value": "medium", "label": "Medium" },
            { "value": "large", "label": "Large" }
          ]
        },
        {
          "type": "url",
          "id": "card_link",
          "label": "Card link"
        },
        {
          "type": "color_scheme",
          "id": "color_scheme_mobile",
          "label": "Mobile color scheme",
          "default": "scheme-1"
        },
        {
          "type": "checkbox",
          "id": "show_text_below",
          "label": "Show text below",
          "default": true
        }
      ]
    },
    {
      "type": "contact_info",
      "name": "Contact information",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "phone",
          "options": [
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "address",
              "label": "Address"
            }
          ]
        },
        {
          "type": "text",
          "id": "number",
          "label": "Number",
          "default": "01"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Phone"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>0000 - 123 - 456789</p>"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Contact Info Cards",
      "blocks": [
        {
          "type": "image_card"
        },
        {
          "type": "contact_info",
          "settings": {
            "icon": "phone",
            "number": "01",
            "title": "Phone"
          }
        },
        {
          "type": "contact_info",
          "settings": {
            "icon": "email",
            "number": "02",
            "title": "Email"
          }
        },
        {
          "type": "contact_info",
          "settings": {
            "icon": "address",
            "number": "03",
            "title": "Address"
          }
        }
      ]
    }
  ]
}
{% endschema %}