{{ 'section-contact-form.css' | asset_url | stylesheet_tag }}

{%- liquid assign form_id = 'ContactForm-' | append: section.id
  assign phone_field_index = 1
-%}

<div class="contact-form section section-padding color-{{ section.settings.section_color_scheme }}{% if section.settings.custom_class != blank %} {{ section.settings.custom_class }}{% endif %}"
  style="--section-padding-top: {{ section.settings.padding_top }}px; --section-padding-bottom: {{ section.settings.padding_bottom }}px;">
  <div class="theme-width">
    <div class="contact-form__wrapper flex flex-col blocks-radius color-{{ section.settings.color_scheme }}">
      <div class="contact">
        <div class="contact__wrapper flex justify-center flex-col h-full">
          {% if section.settings.heading != blank %}
            <{{ section.settings.heading_tag }}  class="contact__title inline-richtext {{ section.settings.heading_size }} text-center">
              {{ section.settings.heading }}
            </{{ section.settings.heading_tag }}>
          {% endif %}
          {%- form 'contact', id: form_id, class: 'w-full' -%}
            {% if form.posted_successfully? %}
              <div class="form-status-list" role="status">
                <h3 class="form-message alert alert--success h6 blocks-radius" tabindex="-1" autofocus>
                  {% render 'icon-success' %}
                  {{ 'templates.contact.form.post_success' | t }}
                </h3>
              </div>
            {% elsif form.errors %}
              <div class="form-error alert alert--error blocks-radius">
                <h3 class="form-message form-message--error h6 m-0" role="alert" tabindex="-1" autofocus>
                  {% render 'icon-error', size: 'small' %}
                  {{ 'templates.contact.form.error_heading' | t }}
                </h3>
                <ul role="list">
                  <li>
                    <a href="#ContactForm-email" class="reversed-link">
                      {{ form.errors.translated_fields.email | capitalize }}
                      {{ form.errors.messages.email }}
                    </a>
                  </li>
                </ul>
              </div>
            {% endif %}
            <div class="contact__fields f-grid f-grid-1-cols md:f-grid-2-cols">
              <div class="form-field form-field--name">
                <label class="form-label" for="ContactForm-name-{{ section.id }}">
                  {{ 'templates.contact.form.name' | t }}
                </label>
                <input class="form-control" autocomplete="name" type="text" id="ContactForm-name-{{ section.id }}" name="contact[{{ 'templates.contact.form.name' | t }}]" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}" placeholder="{{ 'templates.contact.form.name' | t }}">
              </div>
              <div class="form-field form-field--email">
                <label class="form-label" for="ContactForm-email-{{ section.id }}">
                  {{ 'templates.contact.form.email' | t }}
                  <span aria-hidden="true">*</span>
                </label>
                <input autocomplete="email" type="email" id="ContactForm-email-{{ section.id }}" class="form-control" name="contact[email]" spellcheck="false" autocapitalize="off" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required placeholder="{{ 'templates.contact.form.email' | t }}">
              </div>
              {% for block in section.blocks %}
                {% assign field_name_default = 'Custom field ' | append: forloop.index %}
                {% assign field_name = block.settings.heading | default: field_name_default %}
                {% if block.settings.field_type == 'phone' %}
                  {% if phone_field_index == 1 %}
                    <div class="form-field form-field--phone{% if block.settings.full_width %} form-field--full{% endif %}" {{ block.shopify_attributes }}>
                      {% if block.settings.heading != blank %}
                        <label class="form-label" for="ContactForm-phone-{{ block.id }}">
                          {{ block.settings.heading }}
                          {% if block.settings.required %}
                            <span aria-hidden="true">*</span>
                          {% endif %}
                        </label>
                      {% endif %}
                      <input type="tel" id="ContactForm-phone-{{ block.id }}" class="form-control" autocomplete="tel" name="contact[{{ 'templates.contact.form.phone' | t }}]" pattern="[0-9\-]*" value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
                        placeholder="{{ block.settings.placeholder | default: 'Phone' }}"
                        {% if block.settings.required %}
                          required
                        {% endif %}>
                    </div>
                    {% assign phone_field_index = phone_field_index | plus: 1 %}
                  {% endif %}
                {% elsif block.settings.field_type == 'text' %}
                  <div class="form-field form-field--text{% if block.settings.full_width %} form-field--full{% endif %}" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                      <label class="form-label" for="ContactForm-text-{{ block.id }}">
                        {{ block.settings.heading }}
                        {% if block.settings.required %}
                          <span aria-hidden="true">*</span>
                        {% endif %}
                      </label>
                    {% endif %}
                    <input type="text" id="ContactForm-text-{{ block.id }}" class="form-control" name="contact[{{ field_name }}]" placeholder="{{ block.settings.placeholder }}"
                      {% if block.settings.required %} required {% endif %}>
                  </div>
                {% elsif block.settings.field_type == 'textarea' %}
                  <div class="form-field form-field--textarea{% if block.settings.full_width %} form-field--full{% endif %}" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                      <label class="form-label" for="ContactForm-textarea-{{ block.id }}">
                        {{ block.settings.heading }}
                        {% if block.settings.required %}
                          <span aria-hidden="true">*</span>
                        {% endif %}
                      </label>
                    {% endif %}
                    <textarea rows="5" id="ContactForm-textarea-{{ block.id }}" class="form-control form-control--textarea" name="contact[{{ field_name }}]" placeholder="{{ block.settings.placeholder }}" {% if block.settings.required %} required {% endif %} ></textarea>
                  </div>
                {% elsif block.settings.field_type == 'select' %}
                  {% assign options = block.settings.select_options | split: ',' %}
                  <div class="form-field form-field--select{% if block.settings.full_width %} form-field--full{% endif %}" {{ block.shopify_attributes }}>
                    {% if block.settings.heading != blank %}
                      <label class="form-label" for="ContactForm-select-{{ block.id }}">
                        {{ block.settings.heading }}
                        {% if block.settings.required %}
                          <span aria-hidden="true">*</span>
                        {% endif %}
                      </label>
                    {% endif %}
                    <div class="select">
                      <select id="ContactForm-select-{{ block.id }}" name="contact[{{ field_name }}]" class="form-control form-control--select" {% if block.settings.required %} required {% endif %}>
                        {% if block.settings.placeholder != blank %}
                          <option value="" disabled selected>
                            {{ block.settings.placeholder }}
                          </option>
                        {% endif %}
                        {% for option in options %}
                          <option value="{{ option | strip }}">
                            {{ option | strip }}
                          </option>
                        {% endfor %}
                      </select>
                      {% render 'icon-caret-down' %}
                    </div>
                  </div>
                {% elsif block.settings.field_type == 'checkbox' %}
                  <div class="form-field form-field--checkbox{% if block.settings.full_width %} form-field--full{% endif %}" {{ block.shopify_attributes }}>
                    <div class="flex items-center gap-x-3">
                      <input type="hidden" name="contact[{{ field_name }}]" value="{{ block.settings.checkbox_uncheck_value }}">
                      <input
                        type="checkbox"
                        name="contact[{{ field_name }}]"
                        id="ContactForm-checkbox-{{ block.id }}"
                        value="{{ block.settings.checkbox_checked_value }}"
                        {% if block.settings.required %}
                          required
                        {% endif %}
                      >
                      {% if block.settings.heading != blank %}
                        <label class="flex-1" for="ContactForm-checkbox-{{ block.id }}">
                          {{ block.settings.heading }}
                          {% if block.settings.required %}
                            <span aria-hidden="true">*</span>
                          {% endif %}
                        </label>
                      {% endif %}
                    </div>
                  </div>
                {% elsif block.settings.field_type == 'radio' %}
                  {% assign options = block.settings.radio_options | split: ',' %}
                  <div class="form-field form-field--radio{% if block.settings.full_width %} form-field--full{% endif %}" {{ block.shopify_attributes }} >
                    {% if block.settings.heading != blank %}
                      <label class="form-label">
                        {{ block.settings.heading }}
                        {% if block.settings.required %}
                          <span aria-hidden="true">*</span>
                        {% endif %}
                      </label>
                    {% endif %}
                    <ul>
                      {% for option in options %}
                        <li class="flex items-center gap-x-3">
                          <input type="radio" name="contact[{{ field_name }}]" id="ContactForm-radio-{{ block.id }}-{{ forloop.index }}" value="{{ option | strip }}" 
                            {% if block.settings.required %}
                              required
                            {% endif %} >
                          <label class="flex-1" for="ContactForm-radio-{{ block.id }}-{{ forloop.index }}">
                            {{ option | strip }}
                          </label>
                        </li>
                      {% endfor %}
                    </ul>
                  </div>
                {% endif %}
              {% endfor %}
              <div class="form-field form-field--full form-field--body">
                <label class="form-label" for="ContactForm-body-{{ section.id }}">
                  {{ 'templates.contact.form.comment' | t }}
                </label>
                <textarea rows="5" id="ContactForm-body-{{ section.id }}" class="form-control form-control--textarea" name="contact[{{ 'templates.contact.form.comment' | t }}]" placeholder="{{ 'templates.contact.form.comment' | t }}">{{ form.body }}</textarea>
              </div>
              <div class="contact__button form-footer text-center form-field--full">
                <button type="submit" class="btn btn--primary">
                  {{ 'templates.contact.form.send' | t }}
                  {{ 'icon-right-arrow.svg' | inline_asset_content }}
                </button>
              </div>
            </div>
          {%- endform -%}
        </div>
      </div>
    </div>
  </div>
</div>
{% schema %}
{
  "name": "Custom Contact Form",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "color_scheme",
      "id": "section_color_scheme",
      "label": "Section color scheme",
      "default": "scheme-1"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Container color scheme",
      "default": "scheme-2"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Contact form"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "default": "h2",
      "options": [
        {
          "value": "h6",
          "label": "H6"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h1",
          "label": "H1"
        }
      ]
    },
    {
      "type": "select",
      "id": "heading_tag",
      "label": "Heading tag",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ]
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "Padding bottom",
      "default": 50
    },
    {
      "type": "text",
      "id": "custom_class",
      "label": "Custom class"
    }
  ],
  "blocks": [
    {
      "type": "custom_field",
      "name": "Custom field",
      "settings": [
        {
          "type": "select",
          "id": "field_type",
          "label": "Field type",
          "default": "text",
          "options": [
            {
              "value": "text",
              "label": "Text"
            },
            {
              "value": "textarea",
              "label": "Textarea"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "select",
              "label": "Select"
            },
            {
              "value": "checkbox",
              "label": "Checkbox"
            },
            {
              "value": "radio",
              "label": "Radio"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Label",
          "default": "Your label"
        },
        {
          "type": "text",
          "id": "placeholder",
          "label": "Placeholder",
          "default": "Your placeholder"
        },
        {
          "type": "checkbox",
          "id": "required",
          "label": "Required",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "full_width",
          "label": "Full width",
          "default": true
        },
        {
          "type": "text",
          "id": "select_options",
          "label": "Select options",
          "default": "Option 1, Option 2, Option 3"
        },
        {
          "type": "text",
          "id": "checkbox_checked_value",
          "label": "Checkbox checked value",
          "default": "Yes"
        },
        {
          "type": "text",
          "id": "checkbox_uncheck_value",
          "label": "Checkbox unchecked value",
          "default": "No"
        },
        {
          "type": "text",
          "id": "radio_options",
          "label": "Radio options",
          "default": "Option 1, Option 2, Option 3"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Contact Form",
      "blocks": [
        {
          "type": "custom_field",
          "settings": {
            "field_type": "phone",
            "heading": "Phone",
            "full_width": true
          }
        }
      ]
    }
  ]
}
{% endschema %}
