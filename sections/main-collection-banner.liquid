{{ 'section-collection-hero.css' | asset_url | stylesheet_tag }}

{% liquid

  assign inner_class = 'btfy-collection-hero__inner relative f-grid f-grid-1-cols f-grid--gap-none color-' | append: section.settings.color_scheme
  assign text_class = ''

  assign color_scheme_first = settings.color_schemes | first
  assign color_inherit = false
  if section.settings.color_scheme == color_scheme_first
    assign color_inherit = true
  endif

%}

<div
  class="btfy-collection-hero btfy-hero {% if color_inherit %} color-inherit{% endif %} section section-padding"
  style="--section-padding-top: {{ section.settings.padding_top }}px;--section-padding-bottom: {{ section.settings.padding_bottom }}px;"
>
  <div class="theme-width">
    <div class="{{ inner_class }}{% unless color_inherit %} blocks-radius{% endunless %}">
      <div class="btfy-collection-hero__text flex flex-col justify-center text-{{ section.settings.text_alignment }}{{ text_class }}">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'collection_info' -%}
              <div
                class="btfy-collection-hero__info section-padding"
                {{ block.shopify_attributes }}
                style="--section-padding-top: {{ block.settings.padding_top }}px; --section-padding-bottom: {{ block.settings.padding_bottom }}px;"
              >
                <{{ block.settings.heading_tag }} class="btfy-collection-hero__title overflow-hidden {{ block.settings.heading_size }}">
                  <span class="visually-hidden">{{ 'sections.collection_template.title' | t }}: </span>
                  <motion-element data-motion="fade-up" class="inline-block">
                    {{- collection.title | escape -}}
                  </motion-element>
                </{{ block.settings.heading_tag }}>
                {%- if block.settings.show_description and collection.description != blank -%}
                  <div class="collection-hero__description text-lg rte">
                    <motion-element
                      data-motion="fade-up"
                      data-motion-delay="50"
                      class="block"
                    >
                      {{- collection.description }}
                    </motion-element>
                  </div>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {% endfor %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:sections.main-collection-banner.name",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:sections.main-collection-banner.settings.paragraph.content"
    },
    {
      "type": "header",
      "content": "t:sections.all.general.name"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.main-collection-banner.settings.settings_header.label"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "t:sections.all.text_alignment.label",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "t:sections.all.text_alignment.options__1.label"
        },
        {
          "value": "center",
          "label": "t:sections.all.text_alignment.options__2.label"
        },
        {
          "value": "right",
          "label": "t:sections.all.text_alignment.options__3.label"
        }
      ]
    },
    {
      "type": "header",
      "content": "t:sections.all.padding.section_padding_heading"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 50
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 50
    }
  ],
  "blocks": [
    {
      "type": "collection_info",
      "name": "t:sections.main-collection-banner.blocks.collection_info.name",
      "limit": 1,
      "settings": [
        {
          "type": "select",
          "id": "heading_size",
          "label": "t:sections.all.text_size.heading.label",
          "default": "hd2",
          "options": [
            {
              "value": "h6",
              "label": "t:sections.all.text_size.options__h6.label"
            },
            {
              "value": "h5",
              "label": "t:sections.all.text_size.options__h5.label"
            },
            {
              "value": "h4",
              "label": "t:sections.all.text_size.options__h4.label"
            },
            {
              "value": "h3",
              "label": "t:sections.all.text_size.options__h3.label"
            },
            {
              "value": "h2",
              "label": "t:sections.all.text_size.options__h2.label"
            },
            {
              "value": "h1",
              "label": "t:sections.all.text_size.options__h1.label"
            },
            {
              "value": "hd3",
              "label": "t:sections.all.text_size.options__hd3.label"
            },
            {
              "value": "hd2",
              "label": "t:sections.all.text_size.options__hd2.label"
            },
            {
              "value": "hd1",
              "label": "t:sections.all.text_size.options__hd1.label"
            }
          ]
        },
        {
          "type": "select",
          "id": "heading_tag",
          "label": "t:sections.all.heading_tag.label",
          "default": "h1",
          "options": [
            {
              "value": "h1",
              "label": "H1"
            },
            {
              "value": "h2",
              "label": "H2"
            },
            {
              "value": "h3",
              "label": "H3"
            },
            {
              "value": "h4",
              "label": "H4"
            },
            {
              "value": "h5",
              "label": "H5"
            },
            {
              "value": "h6",
              "label": "H6"
            }
          ]
        },
        {
          "type": "checkbox",
          "id": "show_description",
          "default": true,
          "label": "t:sections.main-collection-banner.blocks.collection_info.settings.show_description.label"
        },
        {
          "type": "range",
          "id": "padding_top",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "t:sections.all.padding.padding_top",
          "default": 50
        },
        {
          "type": "range",
          "id": "padding_bottom",
          "min": 0,
          "max": 100,
          "step": 2,
          "unit": "px",
          "label": "t:sections.all.padding.padding_bottom",
          "default": 50
        }
      ]
    }
  ]
}
{% endschema %}
